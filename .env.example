# ── Azure OpenAI ──────────────────────────────────────────────
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ── SQL Server ────────────────────────────────────────────────
SQL_SERVER=your_sql_server_host
SQL_DATABASE=your_database_name
SQL_USER=your_sql_username
SQL_PASSWORD=your_sql_password
SQL_PORT=1433
# Set to true if using Azure SQL with SSL
SQL_ENCRYPT=true
# Set to true for local/self-signed certs (dev only)
SQL_TRUST_SERVER_CERTIFICATE=false

# ── Azure AI Search ───────────────────────────────────────────
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=your_azure_search_api_key
AZURE_SEARCH_INDEX_NAME=your_index_name
# The field in your index that contains the document text
AZURE_SEARCH_CONTENT_FIELD=content
# Optional: semantic config name (leave empty to use keyword search only)
AZURE_SEARCH_SEMANTIC_CONFIG=my-semantic-config
# Number of top results to retrieve
AZURE_SEARCH_TOP_K=5

# ── Express Server ────────────────────────────────────────────
PORT=3000
NODE_ENV=development
