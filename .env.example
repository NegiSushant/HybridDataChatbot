# ── Azure OpenAI ──────────────────────────────────────────────
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ── SQL Server ────────────────────────────────────────────────
# When running via Docker: SQL_SERVER=sqlserver (container name)
# When running locally:    SQL_SERVER=localhost
SQL_SERVER=localhost
SQL_DATABASE=AgentDB
SQL_USER=sa
SQL_PASSWORD=YourStrong!Passw0rd
SQL_PORT=1433
# Set to true for Azure SQL / production (SSL)
SQL_ENCRYPT=false
# Set to true when using Docker self-signed certificate
SQL_TRUST_SERVER_CERTIFICATE=true

# ── Azure AI Search ───────────────────────────────────────────
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=your_azure_search_api_key
AZURE_SEARCH_INDEX_NAME=your_index_name
# The field in your index that contains the document text
AZURE_SEARCH_CONTENT_FIELD=content
# Optional: semantic config name (leave empty to use keyword search only)
AZURE_SEARCH_SEMANTIC_CONFIG=my-semantic-config
# Number of top results to retrieve
AZURE_SEARCH_TOP_K=5

# ── Express Server ────────────────────────────────────────────
PORT=3000
NODE_ENV=development
