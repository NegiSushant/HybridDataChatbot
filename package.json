{
  "name": "agent-with-langchain",
  "version": "1.0.0",
  "description": "Agentic Q&A solution using LangChain, SQL Server, and Azure AI Search",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "docker:db": "docker compose up -d sqlserver sqlserver-init"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@azure/search-documents": "^13.0.0",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.14",
    "@langchain/openai": "^1.6.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "langchain": "^1.5.15",
    "mssql": "^12.7.2",
    "typeorm": "^1.1.1"
  }
}
